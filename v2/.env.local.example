# --- S&S Activewear (apparel catalog) ---
SS_ACCOUNT_NUMBER=your_ss_account_number_here
SS_API_KEY=your_ss_api_key_here
SS_MARKUP_RATE=0.4
# Optional: override which styles load by default on direct API calls.
# Use S&S styleIDs (e.g. 39,7584), NOT manufacturer model names (e.g. 3001CVC).
# Leave unset to use the styles defined in lib/apparel-catalog.ts.
# SS_DEFAULT_STYLES=39,7584
SS_EXPOSE_WHOLESALE=false

# --- Quote email ---
# Configure ONE provider. Resend wins if both are set.
# Verify delivery any time at: http://localhost:3000/api/email-test
#
# OPTION A — Resend: get a free API key at https://resend.com (API Keys).
RESEND_API_KEY=your_resend_api_key_here
#
# OPTION B — your own Gmail (no new signup, no domain verification).
# Requires 2-Step Verification, then a Google App Password
# (Google Account > Security > 2-Step Verification > App passwords).
# GMAIL_USER=you@gmail.com
# GMAIL_APP_PASSWORD=your_16_char_app_password
# Where submitted quotes are emailed:
QUOTE_TO_EMAIL=quote@gorillasalem.com
# Sender. For quick testing use Resend's sandbox address below (it can only
# email the address you signed up with). Once you verify gorillasalem.com in
# Resend, switch this to something like "Gorilla Salem Quotes <quotes@gorillasalem.com>".
QUOTE_FROM_EMAIL=Gorilla Salem Quotes <onboarding@resend.dev>

# --- Printavo (v3.0.0) ---
# Optional. If any of these are missing, pushing quotes to Printavo is skipped
# safely and the app keeps working exactly as before.
# Requires Printavo API v2 access (a qualifying plan).
# Verify your credentials at: http://localhost:3000/api/printavo-test
PRINTAVO_EMAIL=your_printavo_account_email_here
PRINTAVO_TOKEN=your_printavo_api_token_here
# The Printavo customer whose primary contact web quotes attach to.
PRINTAVO_CUSTOMER_ID=your_printavo_customer_id_here
